# Rasamrat Dairy - Production Backend Environment Variables
PORT=5000
NODE_ENV=production

# MongoDB Atlas Production Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/rasamrat_dairy?retryWrites=true&w=majority

# JWT Authentication Secret (Use strong 64-char random string)
JWT_SECRET=your_production_super_secret_jwt_key_here_min_64_chars

# Customer Frontend Production Domain (CORS origin)
CLIENT_URL=https://rasamratdairy.com
